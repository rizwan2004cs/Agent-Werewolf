# --- LLM (OpenAI) ---
# Leave OPENAI_API_KEY empty to run in keyless MOCK mode (canned agents, no cost).
# Set it to use real OpenAI for the agents.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Chain (contract.dev stagenet) ---
# Filled in at Milestone 4/5 once the contract is deployed.
RPC_URL=
CHAIN_ID=
CONTRACT_ADDRESS=
OPERATOR_KEY=
