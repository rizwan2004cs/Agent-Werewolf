# --- LLM ---
# Pick ONE provider (both use the OpenAI-compatible API), or neither for MOCK mode.
#   OpenAI: set OPENAI_API_KEY  (model defaults to gpt-4o-mini)
#   Groq:   set GROQ_API_KEY    (model defaults to llama-3.3-70b-versatile)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (free tier) — used when OPENAI_API_KEY is empty and this is set.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Pacing ---
# PACE=0 runs instantly (tests); >1 slows the "beats" for a live demo.
PACE=1.0
