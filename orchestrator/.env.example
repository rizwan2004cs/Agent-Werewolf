# ---- Agents ----
# Leave ANTHROPIC_API_KEY unset (or MOCK_AGENTS=1) to run agents in mock mode.
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-haiku-4-5-20251001
# MOCK_AGENTS=1

# ---- Chain ----
# MOCK_CHAIN=1 (default) runs the whole game with no wallet. Set to 0 for Monad testnet.
MOCK_CHAIN=1
RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143
GAME_CONTRACT=0x...          # from shared/deployed.json after you deploy
BETTING_CONTRACT=0x...       # from shared/deployed.json after you deploy
ORCHESTRATOR_KEY=0x...       # funded wallet that creates games / resolves on agents' behalf

# ---- Game tuning ----
GAME_POT_MON=1.0
MAX_ROUNDS=2
DISCUSSION_ROUNDS=2
PACE_SECONDS=1.2
