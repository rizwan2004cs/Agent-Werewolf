{
  "name": "pack-contracts",
  "version": "1.0.0",
  "description": "Agent Werewolf smart contracts for Monad testnet",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "export-abi": "node scripts/export-abi.js",
    "build": "hardhat compile && node scripts/export-abi.js",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network monad",
    "deploy:testnet": "hardhat run scripts/deploy.js --network monadTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0"
  }
}
