# Pack — single root .env (monorepo). Copy to `.env` and fill in. Gitignored.
# Read by: orchestrator (via game/__init__.py) AND contracts (via hardhat.config.js).

# ---- Agents ----
# Set OPENAI_API_KEY to use OpenAI, or ANTHROPIC_API_KEY for Claude.
# Neither set (or MOCK_AGENTS=1) -> deterministic mock mode (runs offline).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AGENT_MODEL=gpt-4o-mini
# MOCK_AGENTS=1

# ---- Chain ----
# MOCK_CHAIN=1 keeps everything offline (no wallet needed). Set 0 to go live.
MOCK_CHAIN=1
RPC_URL=https://rpc.contract.dev/7a61a13e96b8175dbab19f70930e9bae
CHAIN_ID=143
# Deployer key (0x + 64 hex). Used by Hardhat to deploy AND by the orchestrator
# to sign on-chain calls (ORCHESTRATOR_KEY overrides if you want a separate one).
PRIVATE_KEY=
# Filled automatically by deploy.js:
GAME_CONTRACT=
BETTING_CONTRACT=
# ORCHESTRATOR_KEY=

# ---- Game tuning ----
GAME_POT_MON=1.0
MAX_ROUNDS=2
DISCUSSION_ROUNDS=2
PACE_SECONDS=1.2
