# Pack — single root .env. Copy to `.env` and fill in. Gitignored.
# Read by the backend via game/config.py.

# ---- Agents ----
# Pick ONE provider (or neither). Both use the OpenAI-compatible API.
#   OpenAI: set OPENAI_API_KEY  (model defaults to gpt-4o-mini)
#   Groq:   set GROQ_API_KEY    (model defaults to llama-3.3-70b-versatile)
#   Neither set -> deterministic mock mode (runs fully offline, no cost).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq (free tier). If set (and OPENAI_API_KEY is empty), agents use Groq.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- Game tuning ----
# PACE=0 runs instantly (tests); >1 slows the "beats" for a live demo.
PACE=1.2
MAX_ROUNDS=2
